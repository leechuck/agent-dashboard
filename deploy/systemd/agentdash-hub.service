[Unit]
Description=agentdash hub (fleet dashboard server)
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=-%h/.agentdash/.env
Environment=PATH=%h/.local/bin:%h/.nvm/versions/node/v22.22.0/bin:/usr/local/bin:/usr/bin:/bin
Type=simple
WorkingDirectory=%h/Public/software/agent-dashboard
ExecStart=%h/Public/software/agent-dashboard/.venv/bin/agentdash hub
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
