[Unit]
Description=agentdash node (per-machine collector and hook receiver)
After=network-online.target
Wants=network-online.target

[Service]
Environment=PATH=%h/.local/bin:%h/.nvm/versions/node/v22.22.0/bin:/usr/local/bin:/usr/bin:/bin
Type=simple
WorkingDirectory=%h/Public/software/agent-dashboard
ExecStart=%h/Public/software/agent-dashboard/.venv/bin/agentdash node
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
