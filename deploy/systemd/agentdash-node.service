[Unit]
Description=agentdash node (per-machine collector and hook receiver)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Public/software/agent-dashboard
ExecStart=%h/Public/software/agent-dashboard/.venv/bin/agentdash node
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
