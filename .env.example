# Copied to ~/.agentdash/.env on each machine. Never commit the real file.
AGENTDASH_HUB_URL=wss://ws.example.ts.net/nodes
AGENTDASH_NODE_TOKEN=change-me
AGENTDASH_WEB_TOKEN=change-me
OPENROUTER_API_KEY=
AGENTDASH_PUSH_SUBJECT=mailto:you@example.com

# Cockpit briefing. Default: headless local `claude -p` on the subscription login.
# AGENTDASH_COCKPIT_NODE=lc-dell          # hub: which machine runs it (others are fallbacks)
# AGENTDASH_COCKPIT_MODEL=sonnet          # node
# AGENTDASH_COCKPIT_CLAUDE_DIR=~/.claude  # node: which login pays for it
# AGENTDASH_COCKPIT_PROVIDER=openai       # node: use an API endpoint instead
# AGENTDASH_COCKPIT_OPENAI_MODEL=anthropic/claude-sonnet-5
# AGENTDASH_COCKPIT_MIN_INTERVAL=600      # hub: seconds between automatic briefings

# Personal briefing (node that has the PA repo and the mail Emacs)
# AGENTDASH_PA_NODE=lc-dell               # hub; default: AGENTDASH_COCKPIT_NODE
# AGENTDASH_PA_DIR=~/pa                   # node
# AGENTDASH_PA_EMACS_SERVER=gnus          # node: emacsclient -s <name>

# Keys for model endpoints (Settings, Model endpoints, name the variable; the value lives here,
# on every machine that should use the endpoint)
# BORG_LLM_API_KEY=
